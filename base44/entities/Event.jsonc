{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string"
    },
    "price_per_photo": {
      "type": "number",
      "default": 3
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "is_live": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "slug"
  ]
}