{
  "name": "SyncStatus",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "uploading"
      ],
      "default": "idle"
    }
  },
  "required": [
    "event_id"
  ]
}